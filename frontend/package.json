{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:cleanup": "prisma db execute --file prisma/maintenance/purge-expired-runs.sql",
    "db:test:ttl": "node scripts/test-run-ttl.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --conditions=react-server --test src/lib/*.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "7.10.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@next/env": "16.4.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
