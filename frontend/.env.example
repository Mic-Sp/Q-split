# Copy to .env.local in this directory and fill in your credentials.

# FastAPI simulation engine (server-side runtime override).
SIMULATION_API_URL=http://localhost:8000
# Optional server-only shared secret. Match ENGINE_SECRET in the FastAPI environment.
# Set this on both services when the engine is publicly reachable. Never use NEXT_PUBLIC_.
ENGINE_SECRET=
# Legacy build-time fallback when SIMULATION_API_URL is unset.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional Neon PostgreSQL connection for run history and advisor caching.
# Leave blank to run without persistence.
DATABASE_URL=
# Optional direct (unpooled) connection for Prisma migrations and maintenance.
# Falls back to DATABASE_URL when blank.
DATABASE_URL_UNPOOLED=

# Optional Gemini advisor credentials. Leave blank for local diagnostics.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
