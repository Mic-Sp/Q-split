generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StageNode {
  CPU
  GPU
  QPU
}

enum StageStatus {
  OPTIMAL
  WARNING
  CRITICAL_BOTTLENECK
}

model SimulationRun {
  // A stable client-generated UUID makes background-save retries idempotent.
  id                   String      @id @db.Uuid
  // NULL retains pre-session runs in the legacy, unassigned history bucket.
  sessionId            String?     @db.VarChar(128)
  completedAt          DateTime    @db.Timestamptz(3)
  createdAt            DateTime    @default(now()) @db.Timestamptz(3)
  workloadId           String
  workloadName         String
  scaleParam           Int
  scaleLabel           String
  hardwareProfile      String
  stage1Node           StageNode
  stage2Node           StageNode
  stage3Node           StageNode
  executionMode        String
  totalLatencyMs       Float
  bottleneckStatus     StageStatus
  primaryBottleneck    String
  qubitsRequired       Int?
  // RSA-scale depths exceed PostgreSQL's 32-bit integer range.
  circuitDepth         BigInt?
  coherenceSurvivalPct Float?
  requestPayload       Json        @db.JsonB
  telemetry            Json        @db.JsonB
  advisorInsight       Json?       @db.JsonB
  snapshotName         String?     @db.VarChar(120)
  isSnapshot           Boolean     @default(false)
  snapshotUpdatedAt    DateTime?   @db.Timestamptz(3)

  @@index([completedAt(sort: Desc), id(sort: Desc)])
  @@index([workloadId, completedAt(sort: Desc)])
  @@index([isSnapshot, completedAt(sort: Desc)])
  @@index([sessionId, completedAt(sort: Desc), id(sort: Desc)])
  @@index([sessionId, workloadId, completedAt(sort: Desc)])
  @@index([sessionId, isSnapshot, completedAt(sort: Desc)])
}

// Server-generated diagnostics shared across sessions; no ownership or run FK.
// Deleting a benchmark must not evict a reusable configuration from the cache.
model AdvisorCache {
  cacheKey       String   @id @db.VarChar(64)
  runId          String   @db.Uuid
  advisorInsight Json     @db.JsonB
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
}
